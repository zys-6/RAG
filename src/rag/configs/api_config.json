{
    "project_api": {
        "info": {
            "desc": "用于获取中国BQ信息中心项目及其经费等详细情况",
            "url": "http://192.168.1.172:8080/ebpAppSomRuntime/api/som-mgr-objects/graphStatisticQuery",
            "create_time": "2024-10-11 10:38:33",
            "author": "admin"
        },
        "fields": {
            "classKey": "projectInformation",
            "search": [
                {
                    "zh_": "项目来源",
                    "key": "projectInformation",
                    "name": "project_source",
                    "example": [
                        "",
                        "军委机关"
                    ],
                    "type": "in",
                    "field_type": "sysCategory"
                },
                {
                    "zh_": "项目类型",
                    "key": "projectInformation",
                    "name": "project_type",
                    "example": "型号研制",
                    "type": "in",
                    "field_type": "sysCategory"
                },
                {
                    "zh_": "承研单位",
                    "key": "projectInformation",
                    "name": "charge_org",
                    "example": "201所",
                    "type": "in",
                    "field_type": "sysOrg",
                    "index_type": "3"
                },
                {
                    "zh_": "项目重要性",
                    "key": "projectInformation",
                    "name": "project_level",
                    "example": "集团重大工程",
                    "type": "equals",
                    "field_type": "sysOrg"
                },
                {
                    "zh_": "竞标状态",
                    "key": "projectInformation",
                    "name": "projectBidding_bidding_status",
                    "example": "竞标成功",
                    "type": "in",
                    "field_type": "sysOrg"
                },
                {
                    "zh_": "建议主管部门",
                    "key": "projectInformation",
                    "name": "suggest_admin_dept",
                    "example": "科技处",
                    "type": "in",
                    "field_type": "sysDept",
                    "index_type": "4"
                },
                {
                    "zh_": "项目标签",
                    "key": "projectInformation",
                    "name": "project_flag",
                    "example": "重大工程",
                    "type": "in"
                },
                {
                    "zh_": "项目经费",
                    "key": "projectInformation",
                    "name": "total_amount",
                    "example": "大于1000万",
                    "type": [
                        "lessThanOrEquals",
                        "equals",
                        "greaterThanOrEquals"
                    ]
                },
                {
                    "zh_": "立项时间",
                    "key": "projectInformation",
                    "name": "confirm_date",
                    "example": [
                        "2012年1月1日",
                        "2024年1月1日"
                    ],
                    "type": "between",
                    "is_time": true
                },
                {
                    "zh_": "项目状态",
                    "key": "projectInformation",
                    "name": "project_status",
                    "example": "竞标",
                    "type": "equals",
                    "is_time": false
                },
                {
                    "zh_": "项目定位",
                    "key": "projectInformation",
                    "name": "project_position",
                    "example": "中低端",
                    "type": "equals",
                    "is_time": false
                }
            ],
            "group": [
                {
                    "zh_": "分组",
                    "key": "projectInformation",
                    "name": "confirm_date",
                    "type": "datetime",
                    "example": "按时间进行统计",
                    "extr": "{\"format\" : \"year\"}"
                },
                {
                    "zh_": "分组",
                    "key": "projectInformation",
                    "name": "project_source",
                    "type": "syscategory",
                    "example": "按项目来源统计",
                    "extr": "{\"categoryKey\" : \"GP.ProjectFrom\"}"
                },
                {
                    "zh_": "分组",
                    "key": "projectInformation",
                    "name": "project_type",
                    "type": "syscategory",
                    "example": "按项目类型统计",
                    "extr": "{\"categoryKey\" : \"GP.ProjectType\"}"
                },
                {
                    "zh_": "分组",
                    "key": "projectInformation",
                    "name": "project_level",
                    "type": "sysdic",
                    "example": "按项目重要性统计",
                    "extr": "{\"dicKey\" : \"gpProjectStar\"}"
                },
                {
                    "zh_": "分组",
                    "key": "projectInformation",
                    "name": "project_status",
                    "type": "sysdic",
                    "example": "按项目状态统计",
                    "extr": "{\"dicKey\" : \"prjStatus\"}"
                }
            ],
            "order": [
                {
                    "zh_": "结果形式",
                    "name": "total_amount",
                    "key": "projectInformation",
                    "type": "sum",
                    "example": "项目经费情况"
                },
                {
                    "zh_": "结果形式",
                    "key": "projectInformation",
                    "example": "项目数量情况",
                    "type": "count"
                }
            ]
        }
    },
